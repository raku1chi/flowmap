{
  "name": "flowmap",
  "version": "0.1.0",
  "description": "SPA を自動探索して画面遷移をフローチャートとスクリーンショットで一望するツール",
  "type": "module",
  "private": true,
  "bin": {
    "flowmap": "./bin/flowmap.mjs"
  },
  "scripts": {
